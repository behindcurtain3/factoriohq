<%= turbo_stream_from "factorio_servers" %>
<% @servers.each do |server| %><%= turbo_stream_from server %><% end %>
<div class="d-flex justify-content-between align-items-center mb-4">
  <h1>Your Factorio Servers</h1>
  <%= link_to new_factorio_server_path, class: "btn btn-primary" do %>
    <i class="bi bi-plus"></i> New Server
  <% end %>
</div>

<% if @servers.empty? %>
  <div class="card">
    <div class="card-body text-center">
      <p class="card-text text-muted">You don't have any Factorio servers yet.</p>
      <p class="mt-4">
        <%= link_to "Create your first server", new_factorio_server_path, class: "btn btn-primary" %>
      </p>
    </div>
  </div>
<% else %>
  <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    <% @servers.each do |server| %>
      <% connect_address = "#{request.host}:#{server.port}" %>
      <div class="col">
        <div class="card server-card h-100">
          <div class="card-header d-flex justify-content-between align-items-center">
            <%= link_to server.name, factorio_server_path(server), class: "server-card-title text-truncate" %>
            <span class="badge <%= server.running? ? 'bg-success' : 'bg-secondary' %>">
              <%= server.status.capitalize %>
            </span>
          </div>
          <div class="card-body d-flex flex-column">
            <div class="mb-3" data-controller="clipboard" data-clipboard-text-value="<%= connect_address %>">
              <label class="connect-label">Connect Address</label>
              <div class="connect-field">
                <code class="connect-addr"><%= connect_address %></code>
                <button type="button" class="btn btn-sm btn-outline-primary connect-copy"
                        data-clipboard-target="button" data-action="clipboard#copy"
                        title="Copy address to clipboard" aria-label="Copy address">
                  <i class="bi bi-clipboard"></i>
                </button>
              </div>
            </div>

            <% if server.description.present? %>
              <p class="card-text text-truncate text-muted mb-0"><%= server.description %></p>
            <% end %>
          </div>

          <div class="card-footer">
            <div class="server-meta">
              <% if server.game_password.present? %>
                <span class="server-pw me-auto" title="Hover to reveal &middot; click to copy"
                      data-controller="clipboard" data-clipboard-text-value="<%= server.game_password %>"
                      data-action="click->clipboard#copy">
                  <i class="bi bi-lock-fill pw-icon-locked"></i>
                  <i class="bi bi-unlock-fill pw-icon-unlocked"></i>
                  <span class="pw-label">Locked</span>
                  <span class="pw-value" data-clipboard-target="button"><%= server.game_password %></span>
                </span>
              <% end %>
              <% if server.mods.any? %>
                <span title="Installed mods"><i class="bi bi-puzzle"></i><%= server.mods.count %> mods</span>
              <% end %>
              <span title="Factorio version"><i class="bi bi-tag"></i><%= server.version.presence || "latest" %></span>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% end %>