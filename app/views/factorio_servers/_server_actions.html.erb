<div class="d-flex flex-wrap gap-2 align-items-center" id="server-actions">
  <% if server.running? %>
    <%= button_to stop_factorio_server_path(server),
                 class: "btn btn-danger",
                 data: { turbo: true },
                 disabled: server.status == 'stopping' do %>
      <% if server.status == 'stopping' %>
        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
      <% else %>
        <i class="bi bi-stop-fill"></i>
      <% end %>
      Stop Server
    <% end %>
  <% else %>
    <%= button_to start_factorio_server_path(server),
                 class: "btn btn-success",
                 data: { turbo: true },
                 disabled: server.status == 'starting' || !server.host_ready? do %>
      <% if server.status == 'starting' %>
        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
      <% else %>
        <i class="bi bi-play-fill"></i>
      <% end %>
      Start Server
    <% end %>
    <% if !server.host_ready? && (host_message = server.host_status_message).present? %>
      <span class="text-muted small"><%= host_message %></span>
    <% end %>
  <% end %>

  <% if server.stopped? %>
    <%= link_to factorio_server_server_mods_path(@server), class: 'btn btn-info' do %>
      <i class="bi bi-puzzle"></i> Manage Mods
    <% end %>
    <%= link_to factorio_server_save_files_path(@server), class: 'btn btn-info' do %>
      <i class="bi bi-archive"></i> Manage Saves
    <% end %>
    <%= link_to edit_factorio_server_path(@server), class: "btn btn-warning" do %>
      <i class="bi bi-pencil-square"></i> Edit Settings
    <% end %>
    <button type="button" class="btn btn-info" data-bs-toggle="modal" data-bs-target="#versionModal">
      <i class="bi bi-box-seam"></i> Change Version
    </button>
  <% end %>

  <% if server.version == 'latest' || server.version.blank? %>
    <%= link_to check_updates_factorio_server_path(server), class: "btn btn-info" do %>
      <i class="bi bi-cloud-arrow-down"></i> Check for Updates
    <% end %>
  <% end %>

  <%= button_to factorio_server_path(server),
               method: :delete,
               form_class: "ms-auto",
               data: { confirm: "Are you sure you want to delete this server?" },
               class: "btn btn-danger",
               disabled: server.status == 'starting' || server.status == 'stopping' do %>
    <i class="bi bi-trash3"></i> Delete Server
  <% end %>
</div>
