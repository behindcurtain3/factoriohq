FACTORIO_DATA_PATH=<path to where you want to store Factorio server data>
DOCKER_URL=unix:///var/run/docker.sock
# Comma-separated list of Host header values the app should accept (DNS
# rebinding protection). Leave unset to use the per-environment defaults.
# Example: example.com,www.example.com
APP_HOSTS=

# --- Docker Compose only (see docker-compose.yml) ---
# Contents of config/master.key, used to decrypt Rails credentials in production.
RAILS_MASTER_KEY=
# Host port to publish the web app on (defaults to 80).
WEB_PORT=80
# Host's docker group id so the container can access the Docker socket.
# Find it with: getent group docker | cut -d: -f3
DOCKER_GID=999
